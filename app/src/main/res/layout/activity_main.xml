<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#080B12">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:text="A32 PHONE DOCTOR" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Samsung Galaxy A32 • Device Health Center" android:textColor="#8F9AAF" android:textSize="14sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_marginTop="18dp" android:background="@drawable/card" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="DEVICE HEALTH" android:textColor="#8F9AAF" android:textSize="12sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/health" android:text="HEALTHY" android:textColor="#66E3A4" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Doctor is stopped" android:textColor="#B9C1D0" android:textSize="14sp" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginEnd="6dp" android:background="@drawable/card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
<TextView android:text="BATTERY" android:textColor="#8F9AAF" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/batteryValue" android:text="--%" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/chargingValue" android:text="Checking…" android:textColor="#66E3A4" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginStart="6dp" android:background="@drawable/card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
<TextView android:text="TEMPERATURE" android:textColor="#8F9AAF" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tempValue" android:text="-- °C" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tempState" android:text="Normal" android:textColor="#66E3A4" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></LinearLayout>
<LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/card" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="SYSTEM STATUS" android:textColor="#8F9AAF" android:textSize="12sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/metrics" android:text="RAM: --\nStorage: --\nCharging: --\nBattery status: --" android:textColor="#DCE2EC" android:textSize="15sp" android:lineSpacingExtra="5dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp" android:background="@drawable/card" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="SMART GAMING" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Monitor heat and battery while playing PUBG. Emergency calls remain unaffected." android:textColor="#8F9AAF" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/gaming" android:text="SMART GAMING MODE: OFF" android:textAllCaps="false" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="48dp"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/start" android:text="START DOCTOR" android:textAllCaps="false" android:layout_marginEnd="5dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
<Button android:id="@+id/stop" android:text="STOP" android:textAllCaps="false" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/touch" android:text="Touch Test" android:textAllCaps="false" android:layout_marginEnd="5dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
<Button android:id="@+id/scan" android:text="Run Full Scan" android:textAllCaps="false" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
</LinearLayout>
<TextView android:text="A32 Phone Doctor • Local device monitor" android:textColor="#596274" android:textSize="11sp" android:gravity="center" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>